{"symbol":"EXHICON","yahoo":"EXHICON.BO","bse":null,"isin":null,"name":"Exhicon Events Media Solutions Limited","sector":"Communication Services","industry":"Advertising Agencies","website":"https://exhiconevents.in","about":"Exhicon Events Media Solutions Limited provides products and services for exhibitions, conferences, and events industries in India. The company offers media and integrated marketing, temporary and permanent event infrastructure, and event management services, as well as web designing and digital marketing services; and designs and constructs B2B and B2C fairs and events and assisting clients with permissions and licenses. It also provides religious tourism, aviation MRO, and corporate event management services. The company serves state governments, domestic associations, hospitality, food and beverages, FMCG, international trading, and healthcare sectors. The company was founded in 1997 and is based in Pune, India.","updated":"2026-09-26T06:21:58+00:00","quote":{"price":519.55,"prevClose":476.9,"marketCap":767.22,"high52":595.0,"low52":390.0,"pe":20.93,"bookValue":135.12,"dividendRate":0.15,"roe":26.99,"shares":1.4767,"insiders":59.88,"institutions":0.0},"prices":{"dates":["2023-04-17","2023-04-18","2023-04-19","2023-04-20","2023-04-21","2023-04-24","2023-04-25","2023-04-26","2023-04-27","2023-04-28","2023-05-02","2023-05-03","2023-05-04","2023-05-05","2023-05-08","2023-05-09","2023-05-10","2023-05-11","2023-05-12","2023-05-15","2023-05-16","2023-05-17","2023-05-18","2023-05-19","2023-05-22","2023-05-23","2023-05-24","2023-05-25","2023-05-26","2023-05-29","2023-05-30","2023-05-31","2023-06-01","2023-06-02","2023-06-05","2023-06-06","2023-06-07","2023-06-08","2023-06-09","2023-06-12","2023-06-13","2023-06-14","2023-06-15","2023-06-16","2023-06-19","2023-06-20","2023-06-21","2023-06-22","2023-06-23","2023-06-26","2023-06-27","2023-06-28","2023-06-30","2023-07-03","2023-07-04","2023-07-05","2023-07-06","2023-07-07","2023-07-10","2023-07-11","2023-