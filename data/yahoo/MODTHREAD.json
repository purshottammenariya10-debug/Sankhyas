{"symbol":"MODTHREAD","yahoo":"MODTHREAD.NS","bse":null,"isin":"INE794W01014","name":"Modern Threads (India) Limited","sector":"Consumer Cyclical","industry":"Textile Manufacturing","website":"https://www.modernwoollens.com","about":"Modern Threads (India) Limited manufactures and sells wool and blended worsted yarn products in India. It offers merino raw white and dyed re-combed wool tops; polyester/wool blended dyed re-combed tops; specialty and worsted woolen yarns; lanolin; wool grease; synthetic yarn; and wool noil and spinning waste products. It also exports its products to Europe and the Middle East, as well as Latin American, the Far eastern, and African countries. Modern Threads (India) Limited was founded in 1973 and is based in Bhilwara, India.","updated":"2026-09-25T13:21:21+00:00","quote":{"price":47.32,"prevClose":47.24,"marketCap":164.56,"high52":65.65,"low52":35.61,"pe":9.1,"bookValue":null,"dividendRate":0.0,"roe":null,"shares":3.4775,"insiders":69.48,"institutions":7.72},"prices":{"dates":["2024-02-16","2024-02-19","2024-02-20","2024-02-21","2024-02-22","2024-02-23","2024-02-26","2024-02-27","2024-02-28","2024-02-29","2024-03-01","2024-03-04","2024-03-05","2024-03-06","2024-03-07","2024-03-11","2024-03-12","2024-03-13","2024-03-14","2024-03-15","2024-03-18","2024-03-19","2024-03-20","2024-03-21","2024-03-22","2024-03-26","2024-03-27","2024-03-28","2024-04-01","2024-04-02","2024-04-03","2024-04-04","2024-04-05","2024-04-08","2024-04-09","2024-04-10","2024-04-12","2024-04-15","2024-04-16","2024-04-18","2024-04-19","2024-04-22","2024-04-23","2024-04-24","2024-04-25","2024-04-26","2024-04-29","2024-04-30","2024-05-02","2024-05-03","2024-05-06","2024-05-07","2024-05-08","2024-05-09","2024-05-10","2024-05-13","2024-05-14","2024-05-15","2024-05-16","2024-05-17","2024-05-21","2024-05-22","2024-05-23","2024-05-24","2024-05-27","2024-05-28","2024-05-29","2024-05-30","2024-05-31","2024-06-03","2024-06-04","2024-06-05","2024-06-06","2024-06-07","2024-06-10","2