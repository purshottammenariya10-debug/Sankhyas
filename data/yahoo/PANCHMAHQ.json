{"symbol":"PANCHMAHQ","yahoo":"PANCHMAHQ.NS","bse":null,"isin":"INE798F01010","name":"Panchmahal Steel Limited","sector":"Basic Materials","industry":"Steel","website":"https://www.panchmahalsteel.co.in","about":"Panchmahal Steel Limited manufactures and sells stainless steel long products in the form of wire rods, bars, and wires in India and internationally. It offers stainless steel wire rods; cold finished bars for precise engineering; and bars for free machining. The company also provides wires for braiding, weaving, knitting, filters, springs, and ball making, as well as for cold heading and fasteners; heat resistant wires; EPQ wires; fine wires; core wires in coils and cut length; and TIG, MIG, and SAW filler wires. Its products are used in engineering, construction and infrastructure, automotive and railways, oil and gas, defense, energy, consumer durables, food processing and dairy, housing, and pharmaceutical industries. Panchmahal Steel Limited was incorporated in 1972 and is based in Vadodara, India. Panchmahal Steel Limited is a subsidiary of Honeyvick Enterprises Private Limited.","updated":"2026-09-25T13:26:32+00:00","quote":{"price":290.1,"prevClose":305.0,"marketCap":null,"high52":339.0,"low52":253.95,"pe":138.14,"bookValue":null,"dividendRate":0.0,"roe":null,"shares":null,"insiders":93.03,"institutions":0.0},"prices":{"dates":["2026-08-18","2026-08-19","2026-08-20","2026-08-21","2026-08-24","2026-08-25","2026-08-26","2026-08-27","2026-08-28","2026-08-31","2026-09-01","2026-09-02","2026-09-03","2026-09-04","2026-09-07","2026-09-08","2026-09-09","2026-09-10","2026-09-11","2026-09-15","2026-09-16","2026-09-17","2026-09-18","2026-09-21","2026-09-22","2026-09-23","2026-09-24","2026-09-25"],"close":[286.85,294.45,299.0,300.0,289.95,289.95,289.95,289.95,304.15,302.0,292.1,300.0,300.0,300.0,296.85,290.0,290.0,290.0,280.0,293.4,295.0,295.0,296.4,301.0,301.0,290.95,305.0,290.1],"volume":[81,1829,93,575,660,0,0,0,297,8,250,290,0,0,27,394,62,0,4,698,180,0,38,2