{"symbol":"JGTL","yahoo":"JGTL.BO","bse":null,"isin":null,"sme":null,"name":"Jasch Gauging Technologies Limited","sector":"Technology","industry":"Scientific & Technical Instruments","website":"https://jasch.net.in","about":"Jasch Gauging Technologies Limited provides industrial gauging systems for flat products processing industry in India. The company offers gauging systems for use in the plastic; papers, boards, and tissues quality control system; paint gauges coatings management system; textiles and non-woven; isotopes/X-ray strip thickness measurement system; and building materials, shingles, felt, rubber sheets, insulation, and glass, as well as continuous galvanizing and galvalume lines measurement system. It also provides upgrade programs for control system and sensor application. Jasch Gauging Technologies Limited was founded in 1998 and is based in New Delhi, India.","updated":"2026-10-03T12:53:01+00:00","quote":{"price":559.9,"prevClose":552.0,"marketCap":253.75,"high52":668.0,"low52":433.0,"pe":16.92,"bookValue":218.94,"dividendRate":20.0,"roe":null,"shares":0.4532,"insiders":69.45,"institutions":0.0},"prices":{"dates":["2024-02-13","2024-02-14","2024-02-15","2024-02-16","2024-02-19","2024-02-20","2024-02-21","2024-02-22","2024-02-23","2024-02-26","2024-02-27","2024-02-28","2024-02-29","2024-03-01","2024-03-04","2024-03-05","2024-03-06","2024-03-07","2024-03-11","2024-03-12","2024-03-13","2024-03-14","2024-03-18","2024-03-19","2024-03-20","2024-03-21","2024-03-22","2024-03-26","2024-03-27","2024-03-28","2024-04-01","2024-04-02","2024-04-03","2024-04-04","2024-04-05","2024-04-08","2024-04-09","2024-04-10","2024-04-12","2024-04-15","2024-04-16","2024-04-18","2024-04-19","2024-04-22","2024-04-23","2024-04-24","2024-04-25","2024-04-26","2024-04-29","2024-04-30","2024-05-02","2024-05-03","2024-05-06","2024-05-07","2024-05-08","2024-05-09","2024-05-10","2024-05-13","2024-05-14","2024-05-15","2024-05-16","2024-05-17","2024-05-21","2024-05-22","2024-05-23","2024