{"symbol":"DYCL","yahoo":"DYCL.NS","bse":null,"isin":"INE600Y01019","sme":null,"name":"Dynamic Cables Limited","sector":"Industrials","industry":"Electrical Equipment & Parts","website":"https://www.dynamiccables.co.in","about":"Dynamic Cables Limited manufactures and supplies cables and conductors in India and internationally. The company offers 66 kV, MV, and LV unarmored aluminum cables; MV single-core aluminum armored and LV copper power cables; MV aerial bunched, LV aluminum multicore FRLS, LV copper armored, railway signaling, LV aerial bunched, UL, solar power AC/DC, and FR-LSH cables; MV covered, ACSR, bare copper, AL59, and AA/AAA conductors; and dynamic building wires. It serves government and private utility and distribution companies, EPC contractors, industrial sectors, solar projects, and railway systems. Dynamic Cables Limited was formerly known as Dynamic Engineers. The company was founded in 1986 and is based in Jaipur, India.","updated":"2026-09-26T10:12:57+00:00","quote":{"price":456.95,"prevClose":473.2,"marketCap":2214.32,"high52":560.0,"low52":236.8,"pe":24.32,"bookValue":94.36,"dividendRate":0.5,"roe":null,"shares":4.8459,"insiders":68.18,"institutions":0.01},"prices":{"dates":["2022-07-27","2022-07-28","2022-07-29","2022-08-01","2022-08-02","2022-08-03","2022-08-04","2022-08-05","2022-08-08","2022-08-10","2022-08-11","2022-08-12","2022-08-16","2022-08-17","2022-08-18","2022-08-19","2022-08-22","2022-08-23","2022-08-24","2022-08-25","2022-08-26","2022-08-29","2022-08-30","2022-09-01","2022-09-02","2022-09-05","2022-09-06","2022-09-07","2022-09-08","2022-09-09","2022-09-12","2022-09-13","2022-09-14","2022-09-15","2022-09-16","2022-09-19","2022-09-20","2022-09-21","2022-09-22","2022-09-23","2022-09-26","2022-09-27","2022-09-28","2022-09-29","2022-09-30","2022-10-03","2022-10-04","2022-10-06","2022-10-07","2022-10-10","2022-10-11","2022-10-12","2022-10-13","2022-10-14","2022-10-17","2022-10-18","2022-10-19","2022-10-20","2022-10-21","2022-10-24",